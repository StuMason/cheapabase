<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "cheapabase docs (Rails)" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:,">
    <%= csrf_meta_tags %>
    <style>
      body { font: 16px/1.5 system-ui, sans-serif; max-width: 42rem; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
      header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
      header a { color: inherit; text-decoration: none; font-weight: 600; }
      form { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin: 0; }
      input, textarea { font: inherit; padding: .4rem .6rem; border: 1px solid #ccd; border-radius: 6px; }
      textarea { width: 100%; min-height: 16rem; box-sizing: border-box; }
      button { font: inherit; padding: .4rem .9rem; border: 0; border-radius: 6px; background: #0d9488; color: #fff; cursor: pointer; }
      button.link { background: none; color: #0d9488; padding: 0; }
      ul { padding-left: 1.2rem; }
      .muted { color: #667; }
      #error { color: #b42318; min-height: 1.5em; }
    </style>
  </head>
  <body>
    <header>
      <a href="<%= root_path %>">cheapabase <span class="muted">docs · Rails</span></a>
      <% if signed_in? %>
        <span class="muted"><%= current_email %>
          <%= button_to "Sign out", session_path, method: :delete, id: "signout", class: "link", form: { style: "display:inline" } %>
        </span>
      <% end %>
    </header>
    <%= yield %>
  </body>
</html>
