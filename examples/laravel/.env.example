APP_NAME="cheapabase docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3002

# Where the cheapabase gateway runs. The anon key is fetched from $CHEAPABASE_URL/config.json.
CHEAPABASE_URL=http://localhost:8000

# Laravel itself needs no database: sessions and cache live in storage/framework.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Let `php artisan serve` handle a few requests at once.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
